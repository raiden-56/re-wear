// ReWear — shared PostgreSQL schema for every role-based application.
// Conventions:
//   * Money is stored as integer paise (₹1 = 100 paise) — never floats.
//   * Weight is stored as integer grams.
//   * Soft deletion uses `deletedAt` where records must stay auditable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum RoleKey {
  CUSTOMER
  COLLECTOR
  WAREHOUSE_MANAGER
  ADMIN
  SUPER_ADMIN
  B2B_BUYER
  RECYCLER_PARTNER
  DONATION_PARTNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SellChannel {
  KG_BUYBACK
  PREMIUM_RESALE
  RECYCLING
  DONATION
}

enum ClothingCondition {
  ANY
  EXCELLENT
  GOOD
  FAIR
  WORN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  SCHEDULED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  COMPLETED
  DISPUTED
  RETURNED
  CANCELLED
  FAILED
}

enum PickupEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  RESCHEDULED
  EN_ROUTE
  ARRIVED
  OTP_VERIFIED
  WEIGHED
  VALUATION_SENT
  VALUATION_APPROVED
  VALUATION_REJECTED
  COMPLETED
  CANCELLED
  FAILED
  RECEIVED_AT_WAREHOUSE
  NOTE
}

enum ValuationStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ValuationSource {
  DOORSTEP
  WAREHOUSE_REINSPECTION
  ADMIN_ADJUSTMENT
}

enum PayoutStatus {
  AWAITING_APPROVAL
  APPROVED
  INITIATED
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
  UNDER_REVIEW
}

enum PayoutAttemptStatus {
  CREATED
  SENT
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
}

enum LedgerAccount {
  CUSTOMER_PAYOUTS
  PAYOUT_CLEARING
  MARKETPLACE_REVENUE
  B2B_REVENUE
  RECYCLING_REVENUE
  LOGISTICS_COST
  SORTING_COST
  PROCESSING_COST
  REFUNDS
  ADJUSTMENTS
  BANK
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum SortGrade {
  UNSORTED
  PREMIUM_REUSABLE
  STANDARD_REUSABLE
  REPAIRABLE
  RECYCLABLE
  UPCYCLING
  REJECTED
}

enum InventoryKind {
  LOT
  UNIT
}

enum InventoryStatus {
  IN_STOCK
  RESERVED
  LISTED
  DISPATCHED
  SOLD
  DONATED
  SCRAPPED
}

enum MovementType {
  RECEIVE
  SORT_IN
  SORT_OUT
  TRANSFER
  ADJUSTMENT
  RESERVE
  RELEASE
  DISPATCH
  SALE
  RETURN
}

enum MovementStatus {
  POSTED
  PENDING_APPROVAL
  REJECTED
}

enum BatchStatus {
  RECEIVED
  SORTING
  SORTED
  CLOSED
}

enum InspectionResult {
  PASSED
  FAILED
  NEEDS_REPAIR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  SOLD_OUT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum BusinessType {
  THRIFT_STORE
  WHOLESALER
  TEXTILE_RECYCLER
  UPCYCLER
  GARMENT_MANUFACTURER
  NGO
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PurchaseOrderStatus {
  REQUESTED
  NEGOTIATING
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum DispatchStatus {
  PLANNED
  DISPATCHED
  DELIVERED
  SETTLED
  CANCELLED
}

enum DonationStatus {
  BOOKED
  COLLECTED
  HANDED_OVER
  ACKNOWLEDGED
  CANCELLED
}

enum RewardType {
  REFERRAL_REFERRER
  REFERRAL_REFEREE
  MILESTONE
  ADJUSTMENT
  REDEMPTION
}

enum NotificationChannel {
  IN_APP
  SMS
  WHATSAPP
  EMAIL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketType {
  GENERAL
  DISPUTE
  PAYMENT
  PICKUP
  ORDER
}

// ──────────────────────── Identity & access ────────────────────────

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  name        String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id            String     @id @default(cuid())
  phone         String?    @unique
  email         String?    @unique
  googleSub     String?    @unique
  name          String?
  avatarUrl     String?
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id])
  status        UserStatus @default(ACTIVE)
  phoneVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  sessions          Session[]
  customerProfile   CustomerProfile?
  collectorProfile  CollectorProfile?
  businessProfile   BusinessProfile?
  recyclerPartner   RecyclerPartner?
  donationPartner   DonationPartner?
  addresses         Address[]
  bookings          Booking[]           @relation("CustomerBookings")
  notifications     Notification[]
  auditLogs         AuditLog[]
  tickets           SupportTicket[]
  supportMessages   SupportMessage[]
  reviews           Review[]
  marketplaceOrders MarketplaceOrder[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  rewardTxns        RewardTransaction[]
  referralsMade     Referral[]          @relation("Referrer")
  referredBy        Referral?           @relation("Referee")
  payouts           Payout[]
  upiAccounts       UpiAccount[]
  donations         Donation[]

  @@index([roleId])
  @@index([createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model CustomerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode      String   @unique
  rewardPoints      Int      @default(0)
  marketingOptIn    Boolean  @default(false)
  whatsappOptIn     Boolean  @default(true)
  showOnLeaderboard Boolean  @default(false)
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CollectorProfile {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode  String             @unique
  serviceAreaId String?
  serviceArea   ServiceArea?       @relation(fields: [serviceAreaId], references: [id])
  vehicleNumber String?
  dailyCapacity Int                @default(12)
  active        Boolean            @default(true)
  assignments   PickupAssignment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([serviceAreaId, active])
}

model BusinessProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName          String
  tradeName          String?
  businessType       BusinessType
  gstin              String?
  pan                String?
  contactEmail       String?
  contactPhone       String?
  addressLine        String?
  city               String?
  state              String?
  pincode            String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  rejectionReason    String?
  priceTier          String             @default("STANDARD")
  discountBps        Int                @default(0)
  purchaseOrders     PurchaseOrder[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([verificationStatus])
}

model Address {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String       @default("Home")
  contactName   String
  contactPhone  String
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String
  pincode       String
  latitude      Float?
  longitude     Float?
  serviceAreaId String?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id])
  isDefault     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  bookings      Booking[]

  @@index([userId])
  @@index([pincode])
}

// ──────────────────────── Operations config ────────────────────────

model ServiceArea {
  id                          String              @id @default(cuid())
  name                        String
  city                        String
  state                       String
  zone                        String
  pincodes                    String[]
  active                      Boolean             @default(true)
  operatingStart              String              @default("09:00")
  operatingEnd                String              @default("19:00")
  operatingDays               Int[]               @default([1, 2, 3, 4, 5, 6])
  minimumKgPolicy             Int                 @default(0) // grams; 0 = no minimum (default policy)
  policyNote                  String?
  logisticsCostPerPickupPaise Int                 @default(0) // internal only — never charged to customers
  slots                       PickupSlot[]
  addresses                   Address[]
  collectors                  CollectorProfile[]
  pricingRules                PricingRule[]
  bookings                    Booking[]
  warehouses                  WarehouseLocation[]
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@unique([city, zone])
  @@index([active])
}

model PickupSlot {
  id            String      @id @default(cuid())
  serviceAreaId String
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  label         String
  startTime     String // "09:00"
  endTime       String // "11:00"
  capacity      Int         @default(10)
  active        Boolean     @default(true)
  bookings      Booking[]

  @@unique([serviceAreaId, startTime])
}

model SlotBlackout {
  id            String   @id @default(cuid())
  serviceAreaId String?
  date          DateTime @db.Date
  reason        String
  createdAt     DateTime @default(now())

  @@index([date])
}

model ClothingCategory {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  description  String?
  group        String               @default("APPAREL")
  imageUrl     String?
  accepted     Boolean              @default(true)
  sortOrder    Int                  @default(0)
  active       Boolean              @default(true)
  pricingRules PricingRule[]
  bookingItems BookingItem[]
  inventory    InventoryItem[]
  products     MarketplaceProduct[]
  listings     BusinessListing[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PricingRule {
  id              String            @id @default(cuid())
  categoryId      String
  category        ClothingCategory  @relation(fields: [categoryId], references: [id])
  channel         SellChannel       @default(KG_BUYBACK)
  condition       ClothingCondition @default(ANY)
  serviceAreaId   String?
  serviceArea     ServiceArea?      @relation(fields: [serviceAreaId], references: [id])
  city            String?
  pricePerKgPaise Int
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  active          Boolean           @default(true)
  approvalStatus  ApprovalStatus    @default(PENDING)
  requestedById   String?
  approvedById    String?
  approvedAt      DateTime?
  notes           String?
  history         PricingHistory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId, channel, active, approvalStatus])
  @@index([effectiveFrom])
}

model PricingHistory {
  id            String      @id @default(cuid())
  pricingRuleId String
  pricingRule   PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)
  action        String // CREATED | APPROVED | REJECTED | DEACTIVATED | EXPIRED
  oldPricePaise Int?
  newPricePaise Int?
  actorId       String?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([pricingRuleId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  key       String
  channel   NotificationChannel
  subject   String?
  body      String
  active    Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  @@unique([key, channel])
}

// ──────────────────────── Bookings & pickup ────────────────────────

model Booking {
  id                String           @id @default(cuid())
  code              String           @unique // human booking ID e.g. RW-24K7-91QF
  customerId        String
  customer          User             @relation("CustomerBookings", fields: [customerId], references: [id])
  channel           SellChannel      @default(KG_BUYBACK)
  status            BookingStatus    @default(SCHEDULED)
  addressId         String
  address           Address          @relation(fields: [addressId], references: [id])
  serviceAreaId     String
  serviceArea       ServiceArea      @relation(fields: [serviceAreaId], references: [id])
  slotId            String
  slot              PickupSlot       @relation(fields: [slotId], references: [id])
  pickupDate        DateTime         @db.Date
  estimatedGrams    Int
  bagCount          Int              @default(1)
  instructions      String?
  photoKeys         String[]
  pickupFeePaise    Int              @default(0) // Free pickup policy — DB CHECK enforces 0
  estimatedPaise    Int              @default(0)
  pricingSnapshot   Json // rates captured at confirmation; historic bookings never change
  pickupOtpHash     String
  donationPartnerId String?
  donationPartner   DonationPartner? @relation(fields: [donationPartnerId], references: [id])
  cancelReason      String?
  failureReason     String?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items       BookingItem[]
  assignments PickupAssignment[]
  events      PickupEvent[]
  weighings   WeighingRecord[]
  valuations  Valuation[]
  batch       CollectionBatch?
  payout      Payout?
  donation    Donation?
  tickets     SupportTicket[]

  @@index([customerId, createdAt])
  @@index([status, pickupDate])
  @@index([serviceAreaId, pickupDate])
}

model BookingItem {
  id             String           @id @default(cuid())
  bookingId      String
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  categoryId     String
  category       ClothingCategory @relation(fields: [categoryId], references: [id])
  estimatedGrams Int
  ratePaisePerKg Int // snapshot
  pricingRuleId  String?
  estimatedPaise Int

  @@unique([bookingId, categoryId])
}

model PickupAssignment {
  id           String           @id @default(cuid())
  bookingId    String
  booking      Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  collectorId  String
  collector    CollectorProfile @relation(fields: [collectorId], references: [id])
  assignedById String?
  active       Boolean          @default(true)
  assignedAt   DateTime         @default(now())
  releasedAt   DateTime?

  @@index([collectorId, active])
  @@index([bookingId, active])
}

model PickupEvent {
  id        String          @id @default(cuid())
  bookingId String
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      PickupEventType
  actorId   String?
  note      String?
  latitude  Float?
  longitude Float?
  meta      Json?
  createdAt DateTime        @default(now())

  @@index([bookingId, createdAt])
}

model WeighingRecord {
  id              String      @id @default(cuid())
  bookingId       String
  booking         Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedById    String
  grossGrams      Int
  tareGrams       Int
  netGrams        Int
  categoryWeights Json // [{categoryId, grams}]
  rejectedGrams   Int         @default(0)
  scalePhotoKey   String?
  evidenceKeys    String[]
  location        String? // "warehouse" | "doorstep"
  createdAt       DateTime    @default(now())
  valuations      Valuation[]

  @@index([bookingId])
}

model Valuation {
  id              String          @id @default(cuid())
  bookingId       String
  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  weighingId      String
  weighing        WeighingRecord  @relation(fields: [weighingId], references: [id])
  version         Int
  source          ValuationSource @default(DOORSTEP)
  status          ValuationStatus @default(PENDING)
  lines           Json // [{categoryId, name, grams, ratePaisePerKg, subtotalPaise}]
  deductions      Json            @default("[]") // [{reason, amountPaise}] — only when policy allows
  grossGrams      Int
  tareGrams       Int
  netGrams        Int
  subtotalPaise   Int
  deductionPaise  Int             @default(0)
  payablePaise    Int
  approvedAt      DateTime?
  approvalMethod  String? // APP | DOORSTEP_OTP
  rejectedAt      DateTime?
  rejectionReason String?
  createdById     String
  createdAt       DateTime        @default(now())

  @@unique([bookingId, version])
  @@index([bookingId, status])
}

// ──────────────────────── Warehouse & inventory ────────────────────────

model WarehouseLocation {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  city          String
  serviceAreaId String?
  serviceArea   ServiceArea?      @relation(fields: [serviceAreaId], references: [id])
  address       String?
  active        Boolean           @default(true)
  batches       CollectionBatch[]
  items         InventoryItem[]
  createdAt     DateTime          @default(now())
}

model CollectionBatch {
  id             String              @id @default(cuid())
  code           String              @unique
  bookingId      String              @unique // one batch per booking — never duplicated
  booking        Booking             @relation(fields: [bookingId], references: [id])
  warehouseId    String
  warehouse      WarehouseLocation   @relation(fields: [warehouseId], references: [id])
  collectorId    String?
  receivedById   String
  collectedGrams Int
  receivedGrams  Int
  sortedGrams    Int                 @default(0)
  varianceGrams  Int                 @default(0)
  status         BatchStatus         @default(RECEIVED)
  receivedAt     DateTime            @default(now())
  sortedAt       DateTime?
  notes          String?
  inspections    QualityInspection[]
  items          InventoryItem[]

  @@index([warehouseId, status])
}

model QualityInspection {
  id          String           @id @default(cuid())
  batchId     String?
  batch       CollectionBatch? @relation(fields: [batchId], references: [id])
  itemId      String?
  item        InventoryItem?   @relation(fields: [itemId], references: [id])
  inspectorId String
  result      InspectionResult
  grade       SortGrade
  notes       String?
  photoKeys   String[]
  createdAt   DateTime         @default(now())

  @@index([itemId])
  @@index([batchId])
}

model InventoryItem {
  id               String              @id @default(cuid())
  code             String              @unique // barcode / QR payload
  kind             InventoryKind       @default(LOT)
  grade            SortGrade
  categoryId       String
  category         ClothingCategory    @relation(fields: [categoryId], references: [id])
  batchId          String?
  batch            CollectionBatch?    @relation(fields: [batchId], references: [id])
  warehouseId      String
  warehouse        WarehouseLocation   @relation(fields: [warehouseId], references: [id])
  weightGrams      Int
  quantity         Int                 @default(1)
  status           InventoryStatus     @default(IN_STOCK)
  title            String?
  brand            String?
  size             String?
  condition        ClothingCondition   @default(ANY)
  photoKeys        String[]
  costPaise        Int                 @default(0)
  inspectionPassed Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  movements        InventoryMovement[]
  inspections      QualityInspection[]
  product          MarketplaceProduct?
  listingLinks     BusinessListing[]

  @@index([grade, status])
  @@index([warehouseId, status])
  @@index([batchId])
}

model InventoryMovement {
  id              String         @id @default(cuid())
  itemId          String
  item            InventoryItem  @relation(fields: [itemId], references: [id])
  type            MovementType
  status          MovementStatus @default(POSTED)
  deltaGrams      Int
  deltaQuantity   Int            @default(0)
  fromWarehouseId String?
  toWarehouseId   String?
  referenceType   String? // BATCH | MARKETPLACE_ORDER | PURCHASE_ORDER | RECYCLER_DISPATCH | DONATION | ADJUSTMENT
  referenceId     String?
  reason          String?
  actorId         String
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@index([itemId, createdAt])
  @@index([referenceType, referenceId])
  @@index([status])
}

// ──────────────────────── Premium marketplace ────────────────────────

model MarketplaceProduct {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  inventoryItemId String?                @unique
  inventoryItem   InventoryItem?         @relation(fields: [inventoryItemId], references: [id])
  name            String
  brand           String?
  categoryId      String
  category        ClothingCategory       @relation(fields: [categoryId], references: [id])
  gender          String?
  size            String
  condition       ClothingCondition
  description     String
  pricePaise      Int
  mrpPaise        Int?
  quantity        Int                    @default(1)
  reserved        Int                    @default(0)
  photoUrls       String[]
  status          ProductStatus          @default(DRAFT)
  publishedAt     DateTime?
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  orderItems      MarketplaceOrderItem[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]

  @@index([status, categoryId])
  @@index([pricePaise])
}

model CartItem {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int                @default(1)
  createdAt DateTime           @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([userId, productId])
}

model MarketplaceOrder {
  id              String                 @id @default(cuid())
  code            String                 @unique
  buyerId         String
  buyer           User                   @relation(fields: [buyerId], references: [id])
  status          OrderStatus            @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus          @default(PENDING)
  subtotalPaise   Int
  shippingPaise   Int                    @default(0)
  totalPaise      Int
  shippingAddress Json
  paymentProvider String?
  paymentRef      String?                @unique
  reservedUntil   DateTime?
  trackingNumber  String?
  courier         String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  items           MarketplaceOrderItem[]
  refunds         Refund[]

  @@index([buyerId, createdAt])
  @@index([status])
}

model MarketplaceOrderItem {
  id         String             @id @default(cuid())
  orderId    String
  order      MarketplaceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    MarketplaceProduct @relation(fields: [productId], references: [id])
  name       String
  pricePaise Int
  quantity   Int
}

model Review {
  id        String             @id @default(cuid())
  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  orderId   String
  rating    Int
  title     String?
  body      String?
  published Boolean            @default(true)
  createdAt DateTime           @default(now())

  @@unique([productId, userId, orderId])
}

model Refund {
  id            String           @id @default(cuid())
  orderId       String
  order         MarketplaceOrder @relation(fields: [orderId], references: [id])
  amountPaise   Int
  reason        String
  status        RefundStatus     @default(REQUESTED)
  providerRef   String?
  requestedById String
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())

  @@index([orderId])
}

// ──────────────────────── B2B ────────────────────────

model BusinessListing {
  id              String           @id @default(cuid())
  code            String           @unique
  title           String
  description     String?
  categoryId      String
  category        ClothingCategory @relation(fields: [categoryId], references: [id])
  grade           SortGrade
  inventoryItemId String?
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  availableGrams  Int
  reservedGrams   Int              @default(0)
  pricePerKgPaise Int
  minOrderGrams   Int
  allowedTypes    BusinessType[]
  photoUrls       String[]
  active          Boolean          @default(true)
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  purchaseOrders  PurchaseOrder[]

  @@index([active, grade])
}

model PurchaseOrder {
  id                    String               @id @default(cuid())
  code                  String               @unique
  businessId            String
  business              BusinessProfile      @relation(fields: [businessId], references: [id])
  listingId             String
  listing               BusinessListing      @relation(fields: [listingId], references: [id])
  requestedGrams        Int
  listPricePerKgPaise   Int
  agreedPricePerKgPaise Int?
  totalPaise            Int?
  status                PurchaseOrderStatus  @default(REQUESTED)
  invoiceNumber         String?              @unique
  deliveryAddress       String?
  courier               String?
  trackingNumber        String?
  confirmedAt           DateTime?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  paymentStatus         PaymentStatus        @default(PENDING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  offers                PurchaseOrderOffer[]

  @@index([businessId, createdAt])
  @@index([status])
}

model PurchaseOrderOffer {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  byRole          String // BUYER | REWEAR
  actorId         String
  pricePerKgPaise Int
  grams           Int
  message         String?
  createdAt       DateTime      @default(now())
}

// ──────────────────────── Recycling & donations ────────────────────────

model RecyclerPartner {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  licenseNumber      String?
  pollutionCertNo    String?
  city               String
  materialsAccepted  String[]
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  ratePerKgPaise     Int                @default(0)
  dispatches         RecyclerDispatch[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model RecyclerDispatch {
  id              String          @id @default(cuid())
  code            String          @unique
  partnerId       String
  partner         RecyclerPartner @relation(fields: [partnerId], references: [id])
  warehouseId     String
  itemIds         String[]
  dispatchedGrams Int
  receivedGrams   Int?
  ratePerKgPaise  Int
  settlementPaise Int?
  status          DispatchStatus  @default(PLANNED)
  vehicleNumber   String?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  settledAt       DateTime?
  settlementRef   String?
  createdById     String
  createdAt       DateTime        @default(now())

  @@index([partnerId, status])
}

model DonationPartner {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id])
  name               String
  registrationNo     String?
  has80G             Boolean            @default(false)
  city               String
  focusAreas         String[]
  description        String?
  verificationStatus VerificationStatus @default(PENDING)
  active             Boolean            @default(true)
  donations          Donation[]
  bookings           Booking[]
  createdAt          DateTime           @default(now())
}

model Donation {
  id              String          @id @default(cuid())
  code            String          @unique
  bookingId       String          @unique
  booking         Booking         @relation(fields: [bookingId], references: [id])
  donorId         String
  donor           User            @relation(fields: [donorId], references: [id])
  partnerId       String
  partner         DonationPartner @relation(fields: [partnerId], references: [id])
  status          DonationStatus  @default(BOOKED)
  collectedGrams  Int?
  receiptNumber   String?         @unique
  acknowledgedAt  DateTime?
  acknowledgement String?
  handedOverAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([partnerId, status])
}

// ──────────────────────── Payouts & finance ────────────────────────

model UpiAccount {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpa        String
  nameAtBank String?
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@unique([userId, vpa])
}

model Payout {
  id            String          @id @default(cuid())
  code          String          @unique
  bookingId     String          @unique // one payout per booking — duplicate payouts impossible
  booking       Booking         @relation(fields: [bookingId], references: [id])
  customerId    String
  customer      User            @relation(fields: [customerId], references: [id])
  valuationId   String          @unique
  amountPaise   Int
  upiVpa        String?
  provider      String
  status        PayoutStatus    @default(AWAITING_APPROVAL)
  providerRef   String?         @unique
  utr           String?
  failureReason String?
  approvedById  String?
  approvedAt    DateTime?
  completedAt   DateTime?
  attemptCount  Int             @default(0)
  version       Int             @default(0) // optimistic lock
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  attempts      PayoutAttempt[]

  @@index([status, createdAt])
  @@index([customerId])
}

model PayoutAttempt {
  id             String              @id @default(cuid())
  payoutId       String
  payout         Payout              @relation(fields: [payoutId], references: [id])
  attemptNumber  Int
  idempotencyKey String              @unique
  status         PayoutAttemptStatus @default(CREATED)
  providerRef    String?             @unique
  utr            String?
  request        Json?
  response       Json?
  failureReason  String?
  initiatedById  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([payoutId, attemptNumber])
}

/// Persistent state for the sandbox payout/payment providers used in development and tests.
model SandboxTransaction {
  id             String   @id @default(cuid())
  kind           String // PAYOUT | PAYMENT | REFUND
  idempotencyKey String   @unique
  reference      String   @unique
  amountPaise    Int
  destination    String?
  status         String
  utr            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model FinancialLedger {
  id             String          @id @default(cuid())
  entryGroup     String // groups the debit/credit legs of one journal entry
  account        LedgerAccount
  direction      LedgerDirection
  amountPaise    Int
  referenceType  String // PAYOUT | MARKETPLACE_ORDER | PURCHASE_ORDER | RECYCLER_DISPATCH | REFUND | COST | ADJUSTMENT
  referenceId    String
  bookingId      String?
  customerId     String?
  description    String
  idempotencyKey String          @unique
  actorId        String?
  createdAt      DateTime        @default(now())

  @@index([account, createdAt])
  @@index([referenceType, referenceId])
  @@index([entryGroup])
}

model OperatingCost {
  id          String        @id @default(cuid())
  account     LedgerAccount
  amountPaise Int
  costDate    DateTime      @db.Date
  city        String?
  description String
  createdById String
  createdAt   DateTime      @default(now())

  @@index([costDate])
}

// ──────────────────────── Engagement ────────────────────────

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referrer    User      @relation("Referrer", fields: [referrerId], references: [id])
  refereeId   String    @unique
  referee     User      @relation("Referee", fields: [refereeId], references: [id])
  status      String    @default("PENDING") // PENDING | QUALIFIED
  qualifiedAt DateTime?
  createdAt   DateTime  @default(now())
}

model RewardTransaction {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  type           RewardType
  points         Int
  description    String
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  delivered Boolean             @default(false)
  error     String?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
}

model SupportTicket {
  id         String           @id @default(cuid())
  code       String           @unique
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  bookingId  String?
  booking    Booking?         @relation(fields: [bookingId], references: [id])
  type       TicketType       @default(GENERAL)
  subject    String
  status     TicketStatus     @default(OPEN)
  priority   String           @default("NORMAL")
  assigneeId String?
  resolution String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   SupportMessage[]

  @@index([status, type])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  internal  Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  topic     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model StoredFile {
  id          String   @id @default(cuid())
  key         String   @unique
  ownerId     String
  contentType String
  sizeBytes   Int
  purpose     String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
