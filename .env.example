# ───────── Core ─────────
DATABASE_URL="postgresql://rewear:rewear_local_dev@127.0.0.1:5433/rewear"
# Separate database used only by `npm test` (it is truncated between tests).
TEST_DATABASE_URL="postgresql://rewear:rewear_local_dev@127.0.0.1:5433/rewear_test"
APP_URL="http://localhost:3000"
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
# Scheduled job auth for /api/cron/reconcile (send as "Authorization: Bearer <secret>")
CRON_SECRET="change-me"

# ───────── OTP / SMS ─────────
# console = log codes to the server console (development). msg91 | twilio for production.
OTP_PROVIDER="console"
# Lets seeded demo numbers (+91 90000 0000x) sign in with 123456. Ignored when NODE_ENV=production.
DEMO_OTP_ENABLED="true"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ───────── WhatsApp Business (Meta Cloud API) ─────────
WHATSAPP_PROVIDER="console"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ───────── Email ─────────
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="ReWear <hello@rewear.example>"

# ───────── Google sign-in (optional) ─────────
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───────── UPI payouts ─────────
# sandbox = local simulator (VPA containing "fail" fails, "reverse" reverses). razorpayx for production.
PAYOUT_PROVIDER="sandbox"
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""
RAZORPAYX_ACCOUNT_NUMBER=""
# Webhook secret configured in the RazorpayX dashboard for /api/webhooks/payouts
PAYOUT_WEBHOOK_SECRET="dev-webhook-secret"

# ───────── Customer payments (marketplace) ─────────
PAYMENT_PROVIDER="sandbox"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET="dev-payment-webhook-secret"

# ───────── File storage ─────────
# local = ./.data/uploads (private, served through an authenticated route). supabase for production.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="rewear-private"

# ───────── Maps (optional) ─────────
NEXT_PUBLIC_MAPS_PROVIDER="google"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Register the service worker in `next dev` (it is always registered in production builds)
NEXT_PUBLIC_SW_DEV="false"
